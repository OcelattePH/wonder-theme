{%- render 'variant-picker',
  product: product,
  block: block,
  product_form_id: product_form_id
-%}

{% schema %}
{
  "name": "Variant picker",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "picker_type",
      "label": "Type",
      "options": [
        { "value": "pills", "label": "Pills" },
        { "value": "dropdown", "label": "Dropdown" }
      ],
      "default": "pills"
    }
  ]
}
{% endschema %}
