<details class="block-accordion" {{ block.shopify_attributes }}>
  <summary class="block-accordion__summary">
    <span>{{ block.settings.heading | default: 'Accordion' }}</span>
    {%- render 'icon-caret' -%}
  </summary>
  <div class="block-accordion__content">
    {% content_for 'blocks' %}
  </div>
</details>

{% schema %}
{
  "name": "Accordion",
  "tag": "div",
  "blocks": [
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ]
}
{% endschema %}
