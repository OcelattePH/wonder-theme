{%- if block.settings.button_label != blank -%}
  <a
    {%- if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% endif %}
    class="button button--{{ block.settings.button_style }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.button_label }}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Link" }
      ],
      "default": "primary"
    }
  ]
}
{% endschema %}
