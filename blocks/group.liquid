{% doc %}
  Layout container block that accepts @theme children.
  Provides layout, size, and spacing style panels.
{% enddoc %}

<div class="block-group" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Group",
  "tag": "div",
  "class": "block-group-wrapper",
  "blocks": [
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "style.layout_panel",
      "id": "layout",
      "label": "Layout"
    },
    {
      "type": "style.size_panel",
      "id": "size",
      "label": "Size"
    },
    {
      "type": "style.spacing_panel",
      "id": "spacing",
      "label": "Spacing"
    }
  ]
}
{% endschema %}
