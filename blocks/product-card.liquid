{%- if block.settings.product != blank -%}
  {%- render 'card-product',
    product: block.settings.product,
    show_vendor: block.settings.show_vendor,
    show_rating: false,
    quick_add: 'none',
    lazy_load: true
  -%}
{%- else -%}
  <div class="card-product card-product--placeholder" {{ block.shopify_attributes }}>
    <div class="card-product__media">
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    </div>
    <div class="card-product__info">
      <h3 class="card-product__title">{{ 'onboarding.product_title' | t }}</h3>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product card",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ]
}
{% endschema %}
