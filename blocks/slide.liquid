{%- if block.settings.image != blank -%}
  <div class="block-slide" {{ block.shopify_attributes }}>
    <div class="block-slide__media">
      {{
        block.settings.image
        | image_url: width: block.settings.image.width
        | image_tag:
          loading: 'lazy',
          widths: '375, 750, 1100, 1500, 1780, 2000, 3000',
          sizes: '100vw'
      }}
    </div>
    {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
      <div class="block-slide__content">
        {%- if block.settings.heading != blank -%}
          <h2 class="block-slide__heading {{ block.settings.heading_size }}">
            {{ block.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="block-slide__text rte">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <a
            {%- if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% endif %}
            class="button button--{{ block.settings.button_style }}"
          >
            {{ block.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Slide",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    }
  ]
}
{% endschema %}
