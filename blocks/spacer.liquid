<div class="block-spacer" style="height: {{ block.settings.height }}px;" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Spacer",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 4,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
