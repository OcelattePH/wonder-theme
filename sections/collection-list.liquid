{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .collection-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .collection-list {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .collection-list__heading {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .collection-list__item {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  #shopify-section-{{ section.id }} .collection-list__link {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .collection-list__image-wrapper {
    position: relative;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.05);
  }

  #shopify-section-{{ section.id }} .collection-list__image-wrapper--adapt {
    aspect-ratio: auto;
  }

  #shopify-section-{{ section.id }} .collection-list__image-wrapper--portrait {
    aspect-ratio: 2 / 3;
  }

  #shopify-section-{{ section.id }} .collection-list__image-wrapper--square {
    aspect-ratio: 1 / 1;
  }

  #shopify-section-{{ section.id }} .collection-list__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .collection-list__title-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .collection-list__title {
    margin: 0;
    font-size: 1.25rem;
  }

  #shopify-section-{{ section.id }} .collection-list__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background-color: rgba(0, 0, 0, 0.05);
  }

  #shopify-section-{{ section.id }} .collection-list__placeholder svg {
    width: 50%;
    height: 50%;
    fill: rgba(0, 0, 0, 0.15);
  }

  {%- if section.settings.swipe_on_mobile -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .collection-list {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding: 1.5rem;
        -webkit-overflow-scrolling: touch;
        gap: 1rem;
        padding-bottom: 0.5rem;
      }

      #shopify-section-{{ section.id }} .collection-list__item {
        flex: 0 0 75%;
        scroll-snap-align: start;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="color-scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="collection-list" role="list">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <li class="collection-list__item" {{ block.shopify_attributes }}>
            <a href="{{ collection.url | default: '#' }}" class="collection-list__link">
              {%- assign card_image = block.settings.image | default: collection.featured_image -%}

              {%- if card_image != blank -%}
                <div class="collection-list__image-wrapper collection-list__image-wrapper--{{ section.settings.image_ratio }}">
                  <img
                    class="collection-list__image"
                    src="{{ card_image | image_url: width: 750 }}"
                    alt="{{ card_image.alt | default: collection.title | escape }}"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                    loading="lazy"
                    srcset="
                      {{ card_image | image_url: width: 375 }} 375w,
                      {{ card_image | image_url: width: 550 }} 550w,
                      {{ card_image | image_url: width: 750 }} 750w
                    "
                    sizes="(min-width: 750px) calc(100vw / {{ section.settings.columns_desktop }}), 75vw"
                  >
                </div>
              {%- else -%}
                <div class="collection-list__placeholder collection-list__image-wrapper--{{ section.settings.image_ratio }}">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              <div class="collection-list__title-wrapper">
                <h3 class="collection-list__title">
                  {{ collection.title | default: 'Collection' | escape }}
                </h3>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
