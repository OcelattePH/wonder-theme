{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .faq__wrapper {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .faq__wrapper {
      padding: 0 5rem;
    }
  }

  #shopify-section-{{ section.id }} .faq__heading {
    font-size: 2.4rem;
    text-align: center;
    margin: 0 0 3rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .faq__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .faq__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .faq__item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #shopify-section-{{ section.id }} .faq__item:first-child {
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #shopify-section-{{ section.id }} .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.8rem 0;
    font-size: 1.6rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    line-height: 1.4;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .faq__question::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .faq__question::marker {
    content: '';
  }

  #shopify-section-{{ section.id }} .faq__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-left: 1.5rem;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .faq__answer {
    padding: 0 0 1.8rem;
    font-size: 1.4rem;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .faq__answer p {
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .faq__answer p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="faq color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="faq__wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq__list" role="list">
        {%- for block in section.blocks -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary class="faq__question">
              <span>{{ block.settings.heading | escape }}</span>
              <svg class="faq__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </summary>
            <div class="faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>

      {%- comment -%} FAQ structured data for search engines {%- endcomment -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.heading | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | json }}
                }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging. Contact our support team to start a return.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "heading": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging. Contact our support team to start a return.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "heading": "How long does shipping take?",
            "answer": "<p>Standard shipping typically takes 5 to 7 business days. Expedited shipping options are available at checkout for faster delivery.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "heading": "Do you ship internationally?",
            "answer": "<p>Yes, we ship to most countries worldwide. International shipping times vary by destination. Customs duties and taxes may apply and are the responsibility of the buyer.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "heading": "How can I track my order?",
            "answer": "<p>Once your order ships, you will receive a confirmation email with a tracking number. You can use this number to track your package on our website or the carrier's site.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
