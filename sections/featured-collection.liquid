{% render 'section-padding' %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign show_view_all = section.settings.show_view_all
  assign enable_slider = section.settings.enable_slider
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .featured-collection__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.4rem;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .featured-collection__heading {
    margin: 0;
    font-size: 2.4rem;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .featured-collection__view-all {
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  #shopify-section-{{ section.id }} .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .featured-collection__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .featured-collection__grid {
      grid-template-columns: repeat({{ columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .featured-collection__slider-wrapper {
    position: relative;
  }

  #shopify-section-{{ section.id }} slider-component {
    display: block;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .slider__list {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-right: 4rem;
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  #shopify-section-{{ section.id }} .slider__list::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .slider__slide {
    flex: 0 0 calc(50% - 0.8rem);
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .slider__slide {
      flex: 0 0 calc(33.333% - 1.1rem);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .slider__slide {
      flex: 0 0 calc({{ 100.0 | divided_by: columns_desktop }}% - {{ 1.6 | times: columns_desktop | minus: 1.6 | divided_by: columns_desktop }}rem);
    }
  }

  #shopify-section-{{ section.id }} .slider-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  #shopify-section-{{ section.id }} .slider-button:hover {
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .slider-button--prev {
    left: -2rem;
  }

  #shopify-section-{{ section.id }} .slider-button--next {
    right: -2rem;
  }

  #shopify-section-{{ section.id }} .slider-button svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-card {
    border: 1px solid #e0e0e0;
    border-radius: 0.8rem;
    overflow: hidden;
    background: #fafafa;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-image {
    aspect-ratio: 1;
    background: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-image--portrait {
    aspect-ratio: 2 / 3;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-image--adapt,
  #shopify-section-{{ section.id }} .featured-collection__placeholder-image--square {
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-image svg {
    width: 50%;
    height: 50%;
    fill: #ccc;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-info {
    padding: 1.2rem;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-title {
    font-size: 1.4rem;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .featured-collection__placeholder-price {
    font-size: 1.3rem;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .slider-button {
      display: none;
    }
  }
{%- endstyle -%}

<div class="color-scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or show_view_all -%}
      <div class="featured-collection__header animate animate--slide-in">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="featured-collection__view-all">
            View all
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      {%- if enable_slider -%}
        <div class="featured-collection__slider-wrapper">
          <slider-component class="featured-collection__slider-component">
            <ul class="slider__list" id="Slider-{{ section.id }}" role="list">
              {%- for product in collection.products limit: products_to_show -%}
                <li class="slider__slide grid__item">
                  {% render 'card-product',
                    product: product,
                    image_ratio: section.settings.image_ratio,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    quick_add: section.settings.quick_add
                  %}
                </li>
              {%- endfor -%}
            </ul>
          </slider-component>

          <button
            class="slider-button slider-button--prev"
            type="button"
            aria-label="Slide left"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button
            class="slider-button slider-button--next"
            type="button"
            aria-label="Slide right"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      {%- else -%}
        <div class="featured-collection__grid">
          {%- for product in collection.products limit: products_to_show -%}
            <div class="grid__item">
              {% render 'card-product',
                product: product,
                image_ratio: section.settings.image_ratio,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                quick_add: section.settings.quick_add
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Skeleton placeholders when no collection is selected {%- endcomment -%}
      {%- if enable_slider -%}
        <div class="featured-collection__slider-wrapper">
          <slider-component class="featured-collection__slider-component">
            <ul class="slider__list" id="Slider-{{ section.id }}" role="list">
              {%- for i in (1..products_to_show) -%}
                <li class="slider__slide grid__item">
                  {% render 'skeleton-product-card' %}
                </li>
              {%- endfor -%}
            </ul>
          </slider-component>

          <button
            class="slider-button slider-button--prev"
            type="button"
            aria-label="Slide left"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button
            class="slider-button slider-button--next"
            type="button"
            aria-label="Slide right"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      {%- else -%}
        <div class="featured-collection__grid">
          {%- for i in (1..products_to_show) -%}
            <div class="grid__item">
              {% render 'skeleton-product-card' %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
  if (!customElements.get('slider-component')) {
    class SliderComponent extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('.slider__list');
        this.prevButton = this.parentElement.querySelector('.slider-button--prev');
        this.nextButton = this.parentElement.querySelector('.slider-button--next');
      }

      connectedCallback() {
        if (!this.slider) return;
        var self = this;

        if (this.prevButton) {
          this.prevButton.addEventListener('click', function() {
            var scrollAmount = self.slider.clientWidth * 0.8;
            self.slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', function() {
            var scrollAmount = self.slider.clientWidth * 0.8;
            self.slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          });
        }
      }
    }

    customElements.define('slider-component', SliderComponent);
  }
</script>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show \"View all\" link"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "default": true,
      "label": "Enable slider"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "none",
      "label": "Quick add button"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
