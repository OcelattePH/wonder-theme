{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .header-section .header__logo-image {
    max-width: {{ section.settings.mobile_logo_width }}px;
  }

  @media screen and (min-width: 990px) {
    .header-section .header__logo-image {
      max-width: {{ section.settings.logo_width }}px;
    }
  }
{%- endstyle -%}

<{% if section.settings.sticky_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_type }}"{% else %}div{% endif %}
  class="header-wrapper color-scheme-{{ section.settings.color_scheme }} {% if section.settings.show_separator_line %}header-wrapper--border-bottom{% endif %}"
>
  <header
    class="header header-section page-width section-{{ section.id }}-padding"
    data-sticky-header
  >
    {%- comment -%} Mobile: hamburger + logo + cart {%- endcomment -%}
    <div class="header__mobile-row large-up-hide">
      <button
        class="header__icon header__icon--menu"
        type="button"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-controls="MobileMenuDrawer"
        aria-expanded="false"
      >
        {%- render 'icon-hamburger' -%}
      </button>

      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{
            section.settings.logo
            | image_url: width: 300
            | image_tag:
              class: 'header__logo-image',
              alt: logo_alt,
              widths: '90, 120, 150, 180, 210, 240, 300',
              sizes: '(max-width: 989px) {{ section.settings.mobile_logo_width }}px, {{ section.settings.logo_width }}px',
              loading: 'lazy'
          }}
        {%- else -%}
          <span class="header__logo-text h5">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- render 'cart-icon-bubble' -%}
    </div>

    {%- comment -%} Desktop: 3-column grid — [nav] [logo] [icons] {%- endcomment -%}
    <div class="header__desktop-row small-hide medium-hide">
      {%- comment -%} Left column: navigation {%- endcomment -%}
      <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="header__nav-list list-unstyled" role="list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="header__nav-item">
              {%- if link.links != blank -%}
                <details class="header__dropdown disclosure">
                  <summary
                    class="header__nav-link"
                    aria-expanded="false"
                    aria-controls="HeaderDropdown-{{ forloop.index }}"
                  >
                    {{ link.title | escape }}
                    {%- render 'icon-caret' -%}
                  </summary>

                  <ul
                    id="HeaderDropdown-{{ forloop.index }}"
                    class="header__dropdown-menu disclosure__list list-unstyled"
                    role="list"
                  >
                    {%- for child_link in link.links -%}
                      <li>
                        <a
                          href="{{ child_link.url }}"
                          class="header__dropdown-link{% if child_link.current %} header__dropdown-link--active{% endif %}"
                          {% if child_link.current %} aria-current="page"{% endif %}
                        >
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="header__nav-link{% if link.current %} header__nav-link--active{% endif %}"
                  {% if link.current %} aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- comment -%} Center column: logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="header__logo-link header__logo-link--center">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'header__logo-image',
              alt: logo_alt,
              widths: '120, 150, 180, 210, 240, 300, 400, 500',
              sizes: '{{ section.settings.logo_width }}px',
              loading: 'lazy'
          }}
        {%- else -%}
          <span class="header__logo-text h4">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- comment -%} Right column: utility icons {%- endcomment -%}
      <div class="header__icons">
        {%- if section.settings.show_search -%}
          <button
            class="header__icon header__icon--search"
            type="button"
            aria-label="{{ 'general.search.search' | t }}"
            aria-controls="SearchOverlay-{{ section.id }}"
            aria-expanded="false"
          >
            {%- render 'icon-search' -%}
          </button>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon header__icon--account"
            aria-label="{{ 'customer.account.title' | t }}"
          >
            {%- render 'icon-account' -%}
          </a>
        {%- endif -%}

        {%- render 'cart-icon-bubble' -%}
      </div>
    </div>
  </header>

  {%- comment -%} Search overlay {%- endcomment -%}
  {%- if section.settings.show_search -%}
    <div class="search-overlay" id="SearchOverlay-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}" hidden>
      <div class="search-overlay__inner page-width">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
          <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'general.search.search' | t }}</label>
          <input
            type="search"
            id="SearchInput-{{ section.id }}"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t }}"
            class="search-overlay__input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <button type="submit" class="search-overlay__submit" aria-label="{{ 'general.search.search' | t }}">
            {%- render 'icon-search' -%}
          </button>
        </form>
        <button class="search-overlay__close" type="button" aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon-close' -%}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Mobile drawer {%- endcomment -%}
  {%- render 'header-drawer', menu: section.settings.menu -%}
</{% if section.settings.sticky_type != 'none' %}sticky-header{% else %}div{% endif %}>

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when '@app' -%}
      {% render block %}
  {%- endcase -%}
{%- endfor -%}

<script>
  /* Sticky header behavior */
  if (!customElements.get('sticky-header')) {
    class StickyHeader extends HTMLElement {
      constructor() {
        super();
        this.header = this.querySelector('[data-sticky-header]');
        this.stickyType = this.dataset.stickyType;
        this.lastScrollTop = 0;
        this.headerHeight = 0;
      }

      connectedCallback() {
        this.headerHeight = this.header.offsetHeight;
        document.documentElement.style.setProperty('--header-height', `${this.headerHeight}px`);

        if (this.stickyType === 'none') return;

        this.style.position = 'sticky';
        this.style.top = '0';
        this.style.zIndex = '1000';

        if (this.stickyType === 'on-scroll-up') {
          this.style.top = `-${this.headerHeight}px`;
          this.style.transition = 'transform var(--duration-long) ease';
          window.addEventListener('scroll', this.onScroll.bind(this), { passive: true });
        }
      }

      onScroll() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;

        if (scrollTop < this.lastScrollTop || scrollTop <= this.headerHeight) {
          this.style.transform = `translateY(${this.headerHeight}px)`;
        } else {
          this.style.transform = 'translateY(0)';
        }

        this.lastScrollTop = scrollTop;
      }
    }

    customElements.define('sticky-header', StickyHeader);
  }

  /* Search overlay toggle */
  document.querySelectorAll('.header__icon--search').forEach((btn) => {
    btn.addEventListener('click', () => {
      const overlay = document.getElementById(btn.getAttribute('aria-controls'));
      if (!overlay) return;
      const isHidden = overlay.hasAttribute('hidden');
      if (isHidden) {
        overlay.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
        overlay.querySelector('.search-overlay__input')?.focus();
      } else {
        overlay.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.querySelectorAll('.search-overlay__close').forEach((btn) => {
    btn.addEventListener('click', () => {
      const overlay = btn.closest('.search-overlay');
      overlay?.setAttribute('hidden', '');
      document.querySelector('[aria-controls="' + overlay?.id + '"]')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "t:sections.header.settings.logo_width.label"
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 30,
      "max": 150,
      "step": 10,
      "default": 90,
      "unit": "px",
      "label": "Mobile logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "sticky_type",
      "options": [
        { "value": "none", "label": "t:sections.header.settings.sticky_header_type.options__1.label" },
        { "value": "on-scroll-up", "label": "t:sections.header.settings.sticky_header_type.options__2.label" },
        { "value": "always", "label": "t:sections.header.settings.sticky_header_type.options__3.label" }
      ],
      "default": "on-scroll-up",
      "label": "t:sections.header.settings.sticky_header_type.label"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search icon"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "default": true,
      "label": "Show account icon"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.header.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_separator_line",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.header.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.header.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
