{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .hero-category-cards-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .hero-category-cards-{{ section.id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-category-card-{{ section.id }} {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius);
    min-height: 400px;
    display: flex;
    align-items: flex-end;
  }

  .hero-category-card__media-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .hero-category-card-{{ section.id }}:hover .hero-category-card__media-{{ section.id }} {
    transform: scale(1.05);
  }

  .hero-category-card__overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 100%);
    z-index: 1;
  }

  .hero-category-card__content-{{ section.id }} {
    position: relative;
    z-index: 2;
    padding: 2.5rem;
    width: 100%;
    color: #fff;
  }

  .hero-category-card__heading-{{ section.id }} {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    color: #fff;
  }

  .hero-category-card__subheading-{{ section.id }} {
    margin: 0 0 1.5rem;
    opacity: 0.85;
    font-size: 1rem;
    color: #fff;
  }

  .hero-category-card__link-{{ section.id }} {
    display: inline-block;
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-category-card__link-{{ section.id }}:hover {
    text-decoration-thickness: 2px;
  }

  .hero-category-card__placeholder-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(var(--color-foreground), 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-category-card__placeholder-{{ section.id }} svg {
    width: 60%;
    height: 60%;
    fill: currentColor;
    opacity: 0.15;
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding{% if section.settings.full_width %} content-container--full-width{% else %} page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}
    <div class="hero-category-cards-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="hero-category-card-{{ section.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 33vw, 100vw',
                widths: '375, 550, 750, 1000, 1250, 1500',
                class: 'hero-category-card__media-' | append: section.id
            }}
          {%- else -%}
            <div class="hero-category-card__placeholder-{{ section.id }}">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div class="hero-category-card__overlay-{{ section.id }}"></div>
          <div class="hero-category-card__content-{{ section.id }}">
            {%- if block.settings.heading != blank -%}
              <h3 class="hero-category-card__heading-{{ section.id }}">
                {{ block.settings.heading | escape }}
              </h3>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="hero-category-card__subheading-{{ section.id }}">
                {{ block.settings.subheading | escape }}
              </p>
            {%- endif -%}
            {%- if block.settings.link_text != blank -%}
              <a
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="hero-category-card__link-{{ section.id }}"
              >
                {{ block.settings.link_text | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero category cards",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Category",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "default": "Shop now",
          "label": "Link text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero category cards",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "heading": "Category one",
            "subheading": "Explore our collection",
            "link_text": "Shop now"
          }
        },
        {
          "type": "category",
          "settings": {
            "heading": "Category two",
            "subheading": "New arrivals",
            "link_text": "Shop now"
          }
        },
        {
          "type": "category",
          "settings": {
            "heading": "Category three",
            "subheading": "Best sellers",
            "link_text": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
