{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .list-collections__title {
    margin-block-end: 3rem;
  }
  .list-collections__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
{%- endstyle -%}

{%- render 'section-padding' -%}

<div class="list-collections color-scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <h1 class="list-collections__title h2 center">{{ 'sections.collection_list.title' | t | default: 'Collections' }}</h1>

    {%- liquid
      assign sort = section.settings.sort
      assign collections_list = collections
    -%}

    <ul class="grid grid--{{ section.settings.columns_desktop }}-col list-collections__list" role="list">
      {%- for collection in collections_list -%}
        {%- unless collection.handle == 'frontpage' -%}
          <li class="grid__item">
            {%- render 'card-collection',
              collection: collection,
              media_aspect_ratio: section.settings.image_ratio,
              columns: section.settings.columns_desktop
            -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section-list-collections",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "select",
      "id": "sort",
      "options": [
        { "value": "alphabetical", "label": "Alphabetically, A-Z" },
        { "value": "alphabetical_reversed", "label": "Alphabetically, Z-A" },
        { "value": "date", "label": "Date, new to old" },
        { "value": "date_reversed", "label": "Date, old to new" },
        { "value": "products_count", "label": "Product count, high to low" },
        { "value": "products_count_reversed", "label": "Product count, low to high" }
      ],
      "default": "alphabetical",
      "label": "Sort collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ]
}
{% endschema %}
