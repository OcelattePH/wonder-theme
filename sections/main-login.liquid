{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer login section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <div id="customer-login" {% if recover_url %}style="display: none;"{% endif %}>
      <h1>{{ 'customer.login.title' | t }}</h1>

      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="form__message" role="alert">
            <h2 class="form__message-title" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#CustomerEmail">{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder=" "
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="CustomerEmail-error"
            {% endif %}
          >
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        </div>

        <div class="field">
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="current-password"
            placeholder=" "
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="CustomerPassword-error"
            {% endif %}
          >
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        </div>

        <a href="#recover" id="RecoverPassword" onclick="document.getElementById('customer-login').style.display='none';document.getElementById('recover').style.display='block';return false;">
          {{ 'customer.login.forgot_password' | t }}
        </a>

        <button type="submit" class="button button--full-width">
          {{ 'customer.login.sign_in' | t }}
        </button>
      {%- endform -%}

      <p>
        {{ 'customer.login.no_account' | t }}
        <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
      </p>
    </div>

    <div id="recover" {% unless recover_url %}style="display: none;"{% endunless %}>
      <h2>{{ 'customer.recover_password.title' | t }}</h2>
      <p>{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <div class="form__message" role="alert">
            <h2 class="form__message-title" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  <a href="#RecoverEmail">{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="form__message form__message--success" role="status">
            <h3 class="form__message-title" tabindex="-1" autofocus>
              {{ 'customer.recover_password.success' | t }}
            </h3>
          </div>
        {%- endif -%}

        <div class="field">
          <input
            type="email"
            name="email"
            id="RecoverEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder=" "
          >
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
        </div>

        <button type="submit" class="button button--full-width">
          {{ 'customer.recover_password.submit' | t }}
        </button>
      {%- endform -%}

      <a href="#login" onclick="document.getElementById('recover').style.display='none';document.getElementById('customer-login').style.display='block';return false;">
        {{ 'customer.recover_password.back_to_login' | t }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["customers/login"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
