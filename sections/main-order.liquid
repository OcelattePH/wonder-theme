{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer order section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="order-header">
      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
      <a href="{{ routes.account_url }}" class="button button--secondary button--small">
        {{ 'customer.account.return' | t }}
      </a>
    </div>

    <p>{{ 'customer.order.date_html' | t: date: order.created_at | time_tag: format: 'date' }}</p>

    {%- if order.cancelled -%}
      <div class="order-cancelled-banner" role="alert">
        <p>{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | time_tag: format: 'date' }}</p>
        <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
      </div>
    {%- endif -%}

    <table class="order-line-items" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">{{ 'customer.order.product' | t }}</th>
          <th role="columnheader" scope="col">{{ 'customer.order.sku' | t }}</th>
          <th role="columnheader" scope="col">{{ 'customer.order.price' | t }}</th>
          <th role="columnheader" scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th role="columnheader" scope="col">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {%- for line_item in order.line_items -%}
          <tr role="row">
            <td role="cell" data-label="{{ 'customer.order.product' | t }}">
              <div class="order-line-item__product">
                {%- if line_item.image -%}
                  <img
                    src="{{ line_item.image | image_url: width: 100 }}"
                    alt="{{ line_item.image.alt | escape }}"
                    width="100"
                    height="{{ 100 | divided_by: line_item.image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                {%- endif -%}
                <div>
                  {%- if line_item.url != blank -%}
                    <a href="{{ line_item.url }}">{{ line_item.title }}</a>
                  {%- else -%}
                    <p>{{ line_item.title }}</p>
                  {%- endif -%}

                  {%- if line_item.variant.title != 'Default Title' -%}
                    <p class="order-line-item__variant">{{ line_item.variant.title }}</p>
                  {%- endif -%}

                  {%- if line_item.selling_plan_allocation -%}
                    <p class="order-line-item__selling-plan">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- if line_item.line_level_discount_allocations.size > 0 -%}
                    <ul class="order-line-item__discounts" role="list">
                      {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                        <li>
                          {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if line_item.fulfillment -%}
                    <div class="order-line-item__fulfillment">
                      <p>{{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | time_tag: format: 'date' }}</p>
                      {%- if line_item.fulfillment.tracking_url -%}
                        <a href="{{ line_item.fulfillment.tracking_url }}">
                          {{ 'customer.order.track_shipment' | t }}
                        </a>
                      {%- endif -%}
                      <p>{{ line_item.fulfillment.tracking_company }}</p>
                      {%- if line_item.fulfillment.tracking_number -%}
                        <p>{{ line_item.fulfillment.tracking_number }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </td>
            <td role="cell" data-label="{{ 'customer.order.sku' | t }}">
              {{ line_item.sku }}
            </td>
            <td role="cell" data-label="{{ 'customer.order.price' | t }}">
              {%- if line_item.original_price != line_item.final_price -%}
                <s>{{ line_item.original_price | money }}</s>
                <span>{{ line_item.final_price | money }}</span>
              {%- else -%}
                {{ line_item.original_price | money }}
              {%- endif -%}

              {%- if line_item.unit_price_measurement -%}
                <p class="order-line-item__unit-price">
                  {{ line_item.unit_price | money }}
                  <span aria-hidden="true">/</span>
                  {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                    {{ line_item.unit_price_measurement.reference_value }}
                  {%- endif -%}
                  {{ line_item.unit_price_measurement.reference_unit }}
                </p>
              {%- endif -%}
            </td>
            <td role="cell" data-label="{{ 'customer.order.quantity' | t }}">
              {{ line_item.quantity }}
            </td>
            <td role="cell" data-label="{{ 'customer.order.total' | t }}">
              {%- if line_item.original_line_price != line_item.final_line_price -%}
                <s>{{ line_item.original_line_price | money }}</s>
                <span>{{ line_item.final_line_price | money }}</span>
              {%- else -%}
                {{ line_item.original_line_price | money }}
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot role="rowgroup">
        <tr role="row">
          <td role="cell" colspan="4">{{ 'customer.order.subtotal' | t }}</td>
          <td role="cell" data-label="{{ 'customer.order.subtotal' | t }}">{{ order.line_items_subtotal_price | money }}</td>
        </tr>

        {%- for discount_application in order.cart_level_discount_applications -%}
          <tr role="row">
            <td role="cell" colspan="4">
              {{ 'customer.order.discount' | t }}: {{ discount_application.title }}
            </td>
            <td role="cell" data-label="{{ 'customer.order.discount' | t }}">
              -{{ discount_application.total_allocated_amount | money }}
            </td>
          </tr>
        {%- endfor -%}

        {%- for shipping_method in order.shipping_methods -%}
          <tr role="row">
            <td role="cell" colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td role="cell" data-label="{{ 'customer.order.shipping' | t }}">{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}

        {%- for tax_line in order.tax_lines -%}
          <tr role="row">
            <td role="cell" colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
            <td role="cell" data-label="{{ 'customer.order.tax' | t }}">{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}

        <tr role="row">
          <td role="cell" colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td role="cell" data-label="{{ 'customer.order.total' | t }}"><strong>{{ order.total_price | money_with_currency }}</strong></td>
        </tr>
      </tfoot>
    </table>

    <div class="order-addresses">
      <div class="order-addresses__billing">
        <h2>{{ 'customer.order.billing_address' | t }}</h2>
        <p>{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>

      <div class="order-addresses__shipping">
        <h2>{{ 'customer.order.shipping_address' | t }}</h2>
        <p>{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-order.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["customers/order"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
