{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <div class="center">
      <h1 class="h2">{{ section.settings.heading | default: 'general.password_page.title' | t }}</h1>
    </div>

    <div class="password-form">
      <h2 class="h4">{{ 'general.password_page.login_form_heading' | t }}</h2>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="form__message" role="alert">
            <h3 class="form__message-title" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#Password">{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field">
          <input
            type="password"
            name="password"
            id="Password"
            autocomplete="current-password"
            placeholder=" "
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="Password-error"
            {% endif %}
          >
          <label for="Password">{{ 'general.password_page.login_password_button' | t }}</label>
        </div>

        <button type="submit" class="button">
          {{ 'general.password_page.login_password_button' | t }}
        </button>
      {%- endform -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="password-newsletter">
        <h2 class="h4">{{ 'general.password_page.signup_form_heading' | t }}</h2>

        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="password page">

          {%- if form.posted_successfully? -%}
            <div class="form__message form__message--success" role="status">
              <p>{{ 'newsletter.success' | t }}</p>
            </div>
          {%- endif -%}

          <div class="field">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder=" "
              required
            >
            <label for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
          </div>

          <button type="submit" class="button">
            {{ 'newsletter.button_label' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
