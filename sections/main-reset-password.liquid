{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer reset-password section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p>{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form__message" role="alert">
          <h2 class="form__message-title" tabindex="-1" autofocus>
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#ResetForm-{{ field }}">{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <input
          type="password"
          name="customer[password]"
          id="ResetForm-password"
          autocomplete="new-password"
          placeholder=" "
          {% if form.errors contains 'password' %}
            aria-invalid="true"
            aria-describedby="ResetForm-password-error"
          {% endif %}
        >
        <label for="ResetForm-password">{{ 'customer.reset_password.password' | t }}</label>
      </div>

      <div class="field">
        <input
          type="password"
          name="customer[password_confirmation]"
          id="ResetForm-password-confirmation"
          autocomplete="new-password"
          placeholder=" "
          {% if form.errors contains 'password_confirmation' %}
            aria-invalid="true"
            aria-describedby="ResetForm-password-confirmation-error"
          {% endif %}
        >
        <label for="ResetForm-password-confirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
      </div>

      <button type="submit" class="button button--full-width">
        {{ 'customer.reset_password.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["customers/reset_password"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
