{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1>{{ 'templates.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <div class="search-form__input-wrapper">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
          autofocus
        >
        <input type="hidden" name="type" value="product,page,article">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">
          {% render 'icon-search' %}
          <span>{{ 'general.search.submit' | t }}</span>
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      <div class="search-type-filters">
        {%- assign current_type = search.terms | split: '' -%}
        <a
          href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product,page,article"
          class="search-type-filter{% unless request.params.type %} search-type-filter--active{% endunless %}"
        >
          {{ 'templates.search.all' | t }} ({{ search.results_count }})
        </a>
        <a
          href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product"
          class="search-type-filter{% if request.params.type == 'product' %} search-type-filter--active{% endif %}"
        >
          {{ 'templates.search.products' | t }}
        </a>
        <a
          href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=page"
          class="search-type-filter{% if request.params.type == 'page' %} search-type-filter--active{% endif %}"
        >
          {{ 'templates.search.pages' | t }}
        </a>
        <a
          href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=article"
          class="search-type-filter{% if request.params.type == 'article' %} search-type-filter--active{% endif %}"
        >
          {{ 'templates.search.articles' | t }}
        </a>
      </div>

      {%- if search.results_count == 0 -%}
        <div class="search-no-results">
          <p>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- else -%}
        <div class="search-results">
          <p class="search-results__count">
            {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
          </p>

          <ul class="search-results__list" role="list">
            {%- for item in search.results -%}
              <li class="search-results__item">
                {%- if item.object_type == 'product' -%}
                  <div class="search-results__product-card">
                    {%- if item.featured_media -%}
                      <a href="{{ item.url }}" class="search-results__image-link">
                        {{
                          item.featured_media
                          | image_url: width: 300
                          | image_tag: loading: 'lazy', widths: '150, 300', sizes: '(max-width: 749px) 150px, 300px'
                        }}
                      </a>
                    {%- endif -%}
                    <div class="search-results__product-info">
                      <a href="{{ item.url }}" class="search-results__product-title">
                        {{ item.title }}
                      </a>
                      <div class="search-results__product-price">
                        {{ item.price | money }}
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  <div class="search-results__content-item">
                    <a href="{{ item.url }}" class="search-results__content-title">
                      {{ item.title }}
                    </a>
                    {%- if item.content != blank -%}
                      <div class="rte search-results__content-excerpt">
                        {{ item.content | strip_html | truncatewords: 30 }}
                      </div>
                    {%- endif -%}
                    <span class="search-results__content-type">
                      {{ item.object_type }}
                    </span>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
