{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .multicolumn__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .multicolumn__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .multicolumn__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .multicolumn__grid--swipe {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .multicolumn__grid--swipe::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .multicolumn__grid--swipe {
      display: grid;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  #shopify-section-{{ section.id }} .multicolumn__grid--swipe .multicolumn__card {
    flex: 0 0 75%;
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .multicolumn__grid--swipe .multicolumn__card {
      flex: none;
    }
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 0.8rem;
    margin-bottom: 1.6rem;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--third {
    width: 33.333%;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--half {
    width: 50%;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--full {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--adapt {
    aspect-ratio: auto;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--portrait {
    aspect-ratio: 2 / 3;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image-wrapper--square {
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-placeholder {
    width: 100%;
    height: 100%;
    min-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e8e8;
    border-radius: 0.8rem;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-placeholder svg {
    width: 50%;
    height: 50%;
    fill: #ccc;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-heading {
    margin: 0 0 0.8rem;
    font-size: 1.8rem;
    line-height: 1.3;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-text {
    margin: 0 0 1.2rem;
    line-height: 1.7;
    font-size: 1.4rem;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-text p {
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .multicolumn__card-link {
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
{%- endstyle -%}

<div class="color-scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="multicolumn__grid{% if section.settings.swipe_on_mobile %} multicolumn__grid--swipe{% endif %}">
        {%- for block in section.blocks -%}
          <div class="multicolumn__card animate animate--slide-in" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="multicolumn__card-image-wrapper multicolumn__card-image-wrapper--{{ section.settings.image_width }} multicolumn__card-image-wrapper--{{ section.settings.image_ratio }}">
                <img
                  class="multicolumn__card-image"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 400 }} 400w,
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 800 }} 800w
                  "
                  sizes="(max-width: 749px) 75vw, (max-width: 989px) 50vw, calc(100vw / {{ section.settings.columns_desktop }})"
                >
              </div>
            {%- else -%}
              <div class="multicolumn__card-placeholder multicolumn__card-image-wrapper--{{ section.settings.image_width }}">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="multicolumn__card-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="multicolumn__card-text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <a
                class="multicolumn__card-link"
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
              >
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        { "value": "third", "label": "One-third width" },
        { "value": "half", "label": "Half width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full",
      "label": "Image width"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Column heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Column one"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Column two"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Column three"
          }
        }
      ]
    }
  ]
}
{% endschema %}
