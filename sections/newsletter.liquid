{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .newsletter {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .newsletter--full-width {
    max-width: none;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .newsletter__inner {
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .newsletter {
      padding: 0 5rem;
    }

    #shopify-section-{{ section.id }} .newsletter--full-width {
      padding: 0 5rem;
    }
  }

  #shopify-section-{{ section.id }} .newsletter__heading {
    font-size: 2.4rem;
    margin: 0 0 1rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .newsletter__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .newsletter__heading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .newsletter__text {
    font-size: 1.4rem;
    line-height: 1.6;
    margin: 0 0 2rem;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .newsletter__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .newsletter__form {
      flex-direction: row;
    }
  }

  #shopify-section-{{ section.id }} .newsletter__input {
    flex-grow: 1;
    padding: 1.2rem 1.6rem;
    font-size: 1.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 0.4rem;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .newsletter__input::placeholder {
    color: rgba(var(--color-foreground), 0.5);
  }

  #shopify-section-{{ section.id }} .newsletter__input:focus {
    outline: none;
    border-color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .newsletter__button {
    padding: 1.2rem 2.4rem;
    font-size: 1.4rem;
    font-weight: 600;
    border: none;
    border-radius: 0.4rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .newsletter__button:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .newsletter__message {
    margin-top: 1rem;
    font-size: 1.3rem;
  }

  #shopify-section-{{ section.id }} .newsletter__message--success {
    color: #2e7d32;
  }

  #shopify-section-{{ section.id }} .newsletter__message--error {
    color: #c62828;
  }
{%- endstyle -%}

<div class="newsletter{% if section.settings.full_width %} newsletter--full-width{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="newsletter__inner animate animate--slide-in">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="newsletter__heading" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- endif -%}

        {%- when 'paragraph' -%}
          {%- if block.settings.text != blank -%}
            <div class="newsletter__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'email_form' -%}
          <div {{ block.shopify_attributes }}>
            {% form 'customer', id: 'NewsletterForm' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter__form">
                <input
                  class="newsletter__input"
                  type="email"
                  name="contact[email]"
                  id="NewsletterEmail-{{ section.id }}"
                  placeholder="{{ 'newsletter.label' | t | default: 'Your email address' }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="Newsletter-error-{{ section.id }}"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="Newsletter-success-{{ section.id }}"
                  {% endif %}
                >
                <button type="submit" class="newsletter__button">
                  {{ 'newsletter.button_label' | t | default: 'Subscribe' }}
                </button>
              </div>

              {%- if form.errors -%}
                <p class="newsletter__message newsletter__message--error" id="Newsletter-error-{{ section.id }}">
                  {%- for field in form.errors -%}
                    {{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}
                  {%- endfor -%}
                </p>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <p class="newsletter__message newsletter__message--success" id="Newsletter-success-{{ section.id }}">
                  {{ 'newsletter.success' | t | default: 'Thanks for subscribing!' }}
                </p>
              {%- endif -%}
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Subscribe to our newsletter"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Sign up for exclusive offers, new arrivals, and insider-only discounts.</p>"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "Email form",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
