{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .product-recommendations__heading {
    margin: 0 0 2.4rem;
    font-size: 2rem;
    line-height: 1.3;
    font-weight: 700;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-recommendations__heading {
      font-size: 2.4rem;
    }
  }

  #shopify-section-{{ section.id }} .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-recommendations__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .product-recommendations__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .product-recommendations__placeholder {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-recommendations__placeholder {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .product-recommendations__placeholder-card {
    background: #f0f0f0;
    border-radius: 0.8rem;
    padding-bottom: 130%;
    position: relative;
  }

  #shopify-section-{{ section.id }} .product-recommendations__placeholder-card svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50%;
    height: 50%;
    fill: #ccc;
  }
{%- endstyle -%}

<div class="color-scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <product-recommendations
      class="product-recommendations"
      data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&intent=related&section_id={{ section.id }}&limit={{ section.settings.products_to_show }}"
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-recommendations__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <ul class="product-recommendations__grid" role="list">
          {%- for recommendation in recommendations.products -%}
            <li class="product-recommendations__item">
              {% render 'card-product', product: recommendation %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </product-recommendations>

    {%- if request.design_mode -%}
      {%- unless recommendations.performed? and recommendations.products_count > 0 -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-recommendations__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="product-recommendations__placeholder">
          {%- for i in (1..section.settings.products_to_show) -%}
            <div class="product-recommendations__placeholder-card">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
    {%- endif -%}
  </div>
</div>

<script>
  if (!customElements.get('product-recommendations')) {
    class ProductRecommendations extends HTMLElement {
      constructor() {
        super();
        this.observer = null;
      }

      connectedCallback() {
        var self = this;
        var url = this.dataset.url;
        if (!url) return;

        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(
            function(entries) {
              if (!entries[0].isIntersecting) return;
              self.observer.unobserve(self);
              self.loadRecommendations(url);
            },
            { rootMargin: '0px 0px 200px 0px' }
          );
          this.observer.observe(this);
        } else {
          this.loadRecommendations(url);
        }
      }

      loadRecommendations(url) {
        var self = this;
        fetch(url)
          .then(function(response) {
            return response.text();
          })
          .then(function(text) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(text, 'text/html');
            var freshContent = doc.querySelector('product-recommendations');

            if (freshContent && freshContent.innerHTML.trim().length > 0) {
              self.innerHTML = freshContent.innerHTML;
            }
          })
          .catch(function(error) {
            console.error('Failed to load product recommendations:', error);
          });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('product-recommendations', ProductRecommendations);
  }
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
