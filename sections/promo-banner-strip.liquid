{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% render 'section-padding' %}

<div class="promo-banner-strip section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="promo-banner-strip__inner">
      {%- for block in section.blocks -%}
        <div class="promo-banner-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="promo-banner-strip__icon">
              {%- case block.settings.icon -%}
                {%- when 'tag' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                {%- when 'gift' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                {%- when 'percent' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                {%- when 'truck' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'shield' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'star' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endcase -%}
            </div>
          {%- endif -%}
          <div class="promo-banner-strip__text">
            {%- if block.settings.heading != blank -%}
              <strong>{{ block.settings.heading }}</strong>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .promo-banner-strip__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem 3.2rem;
    padding: 1.6rem;
    border: 1px dashed rgba(var(--color-foreground), 0.15);
    border-radius: var(--card-corner-radius);
    background: rgba(var(--color-foreground), 0.02);
  }

  #shopify-section-{{ section.id }} .promo-banner-strip__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
  }

  #shopify-section-{{ section.id }} .promo-banner-strip__icon {
    flex-shrink: 0;
    color: rgb(var(--color-foreground));
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .promo-banner-strip__text strong {
    display: block;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .promo-banner-strip__text span {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Promo banner strip",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "promo_item",
      "name": "Promo item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "tag", "label": "Tag" },
            { "value": "gift", "label": "Gift" },
            { "value": "percent", "label": "Percent" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Special offer"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Buy Any 2 & Unlock Extra 20% OFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banner strip",
      "blocks": [
        {
          "type": "promo_item",
          "settings": {
            "icon": "percent",
            "heading": "Bundle & Save",
            "text": "Buy Any 2 & Unlock Extra 20% OFF"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "icon": "truck",
            "heading": "Free Shipping",
            "text": "On orders over $50"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "icon": "shield",
            "heading": "Money Back",
            "text": "30-day guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
