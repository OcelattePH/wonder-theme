{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .scrolling-marquee-{{ section.id }} {
    overflow: hidden;
    white-space: nowrap;
  }

  .scrolling-marquee__track-{{ section.id }} {
    display: inline-flex;
    animation: scrolling-marquee-{{ section.id }} var(--marquee-duration) linear infinite;
  }

  .scrolling-marquee__item-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 2rem;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .scrolling-marquee__separator-{{ section.id }} {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.5;
    flex-shrink: 0;
  }

  @keyframes scrolling-marquee-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }
</style>

{%- liquid
  assign speed = section.settings.speed
  if speed == 'slow'
    assign duration = '40s'
  elsif speed == 'fast'
    assign duration = '15s'
  else
    assign duration = '25s'
  endif
-%}

<div
  class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  style="--marquee-duration: {{ duration }};"
>
  <div class="scrolling-marquee-{{ section.id }}">
    <div class="scrolling-marquee__track-{{ section.id }}">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          <span
            class="scrolling-marquee__item-{{ section.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text | escape }}
          </span>
          <span class="scrolling-marquee__separator-{{ section.id }}" aria-hidden="true"></span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "speed",
      "options": [
        {
          "value": "slow",
          "label": "Slow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "fast",
          "label": "Fast"
        }
      ],
      "default": "medium",
      "label": "Scroll speed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Free shipping on orders over $50",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling marquee",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "Free shipping on orders over $50"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "New arrivals every week"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "30-day hassle-free returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
