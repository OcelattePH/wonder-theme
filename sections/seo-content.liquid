{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% render 'section-padding' %}

<div class="seo-content section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="seo-content__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="seo-content__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text_block' -%}
            <div class="seo-content__block" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="seo-content__block-heading h3">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="seo-content__block-content rte">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <div class="seo-content__block-image">
                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 750, 1100',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'seo-content__image'
                  }}
                </div>
              {%- endif -%}
            </div>

          {%- when 'collapsible' -%}
            <details class="seo-content__collapsible" {{ block.shopify_attributes }}>
              <summary class="seo-content__collapsible-trigger">
                <span>{{ block.settings.heading | default: 'Details' }}</span>
                {% render 'icon-caret' %}
              </summary>
              <div class="seo-content__collapsible-content rte">
                {{ block.settings.content }}
                {%- if block.settings.image != blank -%}
                  <div class="seo-content__block-image">
                    {{
                      block.settings.image
                      | image_url: width: block.settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 750, 1100',
                        sizes: '(min-width: 990px) 50vw, 100vw'
                    }}
                  </div>
                {%- endif -%}
              </div>
            </details>

          {%- when 'two_column' -%}
            <div class="seo-content__two-column" {{ block.shopify_attributes }}>
              <div class="seo-content__two-column-text">
                {%- if block.settings.heading != blank -%}
                  <h3 class="seo-content__block-heading h3">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <div class="rte">{{ block.settings.content }}</div>
                {%- endif -%}
              </div>
              {%- if block.settings.image != blank -%}
                <div class="seo-content__two-column-image">
                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 750, 1100',
                      sizes: '(min-width: 990px) 50vw, 100vw'
                  }}
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .seo-content__heading {
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .seo-content__blocks {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  #shopify-section-{{ section.id }} .seo-content__block-heading {
    margin-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .seo-content__block-image {
    margin-top: 2rem;
    border-radius: var(--card-corner-radius);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .seo-content__image {
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    padding-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.5rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.6rem;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible-trigger::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible-trigger .icon-caret {
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible[open] .seo-content__collapsible-trigger .icon-caret {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .seo-content__collapsible-content {
    padding: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .seo-content__two-column {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .seo-content__two-column {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "SEO content",
  "tag": "section",
  "class": "section-seo-content",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Overview"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "two_column",
      "name": "Text with image",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How to Use"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SEO content",
      "blocks": [
        {
          "type": "text_block",
          "settings": {
            "heading": "Quick Overview"
          }
        },
        {
          "type": "collapsible",
          "settings": {
            "heading": "Who Should Use It"
          }
        },
        {
          "type": "two_column",
          "settings": {
            "heading": "How to Use"
          }
        },
        {
          "type": "collapsible",
          "settings": {
            "heading": "Key Ingredients"
          }
        }
      ]
    }
  ]
}
{% endschema %}
