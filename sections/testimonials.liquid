{% render 'section-padding' %}

{%- style -%}
  #shopify-section-{{ section.id }} .testimonials__wrapper {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .testimonials__wrapper {
      padding: 0 5rem;
    }
  }

  #shopify-section-{{ section.id }} .testimonials__heading {
    font-size: 2.4rem;
    text-align: center;
    margin: 0 0 3rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .testimonials__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .testimonials__slider {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .testimonials__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .testimonials__slide {
    min-width: 100%;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .testimonials__slide {
      min-width: 50%;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .testimonials__slide {
      min-width: 33.333%;
    }
  }

  #shopify-section-{{ section.id }} .testimonials__card {
    background: rgba(var(--color-background), 0.5);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 0.8rem;
    padding: 2.4rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  #shopify-section-{{ section.id }} .testimonials__stars {
    display: flex;
    gap: 0.2rem;
  }

  #shopify-section-{{ section.id }} .testimonials__stars svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .testimonials__stars .star-filled {
    color: #f5a623;
  }

  #shopify-section-{{ section.id }} .testimonials__stars .star-empty {
    color: rgba(var(--color-foreground), 0.15);
  }

  #shopify-section-{{ section.id }} .testimonials__quote {
    font-size: 1.4rem;
    line-height: 1.6;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .testimonials__quote p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .testimonials__author-wrapper {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .testimonials__author-image {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .testimonials__author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(var(--color-foreground), 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .testimonials__author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  #shopify-section-{{ section.id }} .testimonials__author-name {
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .testimonials__author-title {
    font-size: 1.2rem;
    opacity: 0.7;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .testimonials__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  #shopify-section-{{ section.id }} .testimonials__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    color: rgb(var(--color-foreground));
    transition: background 0.2s, border-color 0.2s;
  }

  #shopify-section-{{ section.id }} .testimonials__btn:hover {
    border-color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .testimonials__btn svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .testimonials__dots {
    display: flex;
    gap: 0.6rem;
  }

  #shopify-section-{{ section.id }} .testimonials__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(var(--color-foreground), 0.2);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  #shopify-section-{{ section.id }} .testimonials__dot.active {
    background: rgb(var(--color-foreground));
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="testimonials color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="testimonials__wrapper animate animate--slide-in">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonials__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <slider-component
        id="Slider-{{ section.id }}"
        class="testimonials__slider"
        {% if section.settings.autorotate %}
          data-autorotate="{{ section.settings.autorotate_speed }}"
        {% endif %}
      >
        <div class="testimonials__track" data-slider-track>
          {%- for block in section.blocks -%}
            <div class="testimonials__slide" {{ block.shopify_attributes }} data-slide-index="{{ forloop.index0 }}">
              <div class="testimonials__card">
                {%- if block.settings.rating > 0 -%}
                  <div class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}
                        <svg class="star-filled" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                      {%- else -%}
                        <svg class="star-empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <blockquote class="testimonials__quote rte">{{ block.settings.text }}</blockquote>
                {%- endif -%}

                <div class="testimonials__author-wrapper">
                  {%- if block.settings.image != blank -%}
                    <img
                      class="testimonials__author-image"
                      src="{{ block.settings.image | image_url: width: 96 }}"
                      alt="{{ block.settings.author | escape }}"
                      width="48"
                      height="48"
                      loading="lazy"
                    >
                  {%- elsif block.settings.author != blank -%}
                    <div class="testimonials__author-avatar" aria-hidden="true">
                      {{ block.settings.author | slice: 0 }}
                    </div>
                  {%- endif -%}
                  <div class="testimonials__author-info">
                    {%- if block.settings.author != blank -%}
                      <p class="testimonials__author-name">{{ block.settings.author | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.author_title != blank -%}
                      <p class="testimonials__author-title">{{ block.settings.author_title | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="testimonials__controls">
            <button
              class="testimonials__btn testimonials__btn--prev"
              type="button"
              aria-label="Previous testimonial"
              data-slider-prev
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>

            <div class="testimonials__dots" data-slider-dots>
              {%- for block in section.blocks -%}
                <button
                  class="testimonials__dot{% if forloop.first %} active{% endif %}"
                  type="button"
                  aria-label="Go to testimonial {{ forloop.index }}"
                  data-slide-dot="{{ forloop.index0 }}"
                ></button>
              {%- endfor -%}
            </div>

            <button
              class="testimonials__btn testimonials__btn--next"
              type="button"
              aria-label="Next testimonial"
              data-slider-next
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </slider-component>
    </div>
  </div>
{%- endif -%}

<script>
  if (!customElements.get('slider-component')) {
    class SliderComponent extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-slider-track]');
        this.slides = this.querySelectorAll('[data-slide-index]');
        this.prevBtn = this.querySelector('[data-slider-prev]');
        this.nextBtn = this.querySelector('[data-slider-next]');
        this.dots = this.querySelectorAll('[data-slide-dot]');
        this.currentIndex = 0;
        this.autorotateInterval = null;
      }

      connectedCallback() {
        if (!this.track || this.slides.length === 0) return;

        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.prev());
        }
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.next());
        }
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.goTo(parseInt(dot.dataset.slideDot, 10));
          });
        });

        const autorotateSpeed = this.dataset.autorotate;
        if (autorotateSpeed) {
          this.startAutorotate(parseInt(autorotateSpeed, 10) * 1000);
          this.addEventListener('mouseenter', () => this.stopAutorotate());
          this.addEventListener('mouseleave', () => {
            if (autorotateSpeed) {
              this.startAutorotate(parseInt(autorotateSpeed, 10) * 1000);
            }
          });
        }
      }

      getVisibleSlides() {
        const slideWidth = this.slides[0].offsetWidth;
        const containerWidth = this.track.parentElement.offsetWidth;
        return Math.round(containerWidth / slideWidth);
      }

      getMaxIndex() {
        const visible = this.getVisibleSlides();
        return Math.max(0, this.slides.length - visible);
      }

      goTo(index) {
        const maxIndex = this.getMaxIndex();
        this.currentIndex = Math.max(0, Math.min(index, maxIndex));
        const offset = this.slides[this.currentIndex].offsetLeft - this.track.parentElement.offsetLeft;
        this.track.style.transform = `translateX(-${offset}px)`;
        this.updateDots();
      }

      prev() {
        this.goTo(this.currentIndex - 1);
      }

      next() {
        const maxIndex = this.getMaxIndex();
        if (this.currentIndex >= maxIndex) {
          this.goTo(0);
        } else {
          this.goTo(this.currentIndex + 1);
        }
      }

      updateDots() {
        this.dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === this.currentIndex);
        });
      }

      startAutorotate(ms) {
        this.stopAutorotate();
        this.autorotateInterval = setInterval(() => this.next(), ms);
      }

      stopAutorotate() {
        if (this.autorotateInterval) {
          clearInterval(this.autorotateInterval);
          this.autorotateInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutorotate();
      }
    }

    customElements.define('slider-component', SliderComponent);
  }
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Change slides every"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Quote",
          "default": "<p>This product has completely transformed my daily routine. I can not recommend it enough.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Jane D."
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author title",
          "default": "Verified buyer"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "text": "<p>Absolutely love this product. The quality is outstanding and it arrived quickly.</p>",
            "author": "Sarah M.",
            "author_title": "Verified buyer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "text": "<p>Best purchase I have made this year. Will definitely be ordering again soon.</p>",
            "author": "James R.",
            "author_title": "Repeat customer",
            "rating": 5
          }
        },
        {
          "type": "quote",
          "settings": {
            "text": "<p>Great customer service and the product exceeded my expectations in every way.</p>",
            "author": "Emily T.",
            "author_title": "Verified buyer",
            "rating": 4
          }
        }
      ]
    }
  ]
}
{% endschema %}
