{%- liquid
  assign has_active_filters = false
  for filter in results.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign has_active_filters = true
        break
      endif
    else
      for value in filter.values
        if value.active
          assign has_active_filters = true
          break
        endif
      endfor
      if has_active_filters
        break
      endif
    endif
  endfor
-%}

{%- if has_active_filters -%}
  <div class="active-facets" id="ActiveFacets">
    {%- for filter in results.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          <facet-remove>
            <a href="{{ filter.url_to_remove }}" class="active-facets__tag">
              {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
              -
              {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
              {% render 'icon-close' %}
            </a>
          </facet-remove>
        {%- endif -%}
      {%- else -%}
        {%- for value in filter.values -%}
          {%- if value.active -%}
            <facet-remove>
              <a href="{{ value.url_to_remove }}" class="active-facets__tag">
                {{ filter.label }}: {{ value.label | escape }}
                {% render 'icon-close' %}
              </a>
            </facet-remove>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    <a href="{{ results.url }}" class="active-facets__clear">Clear all</a>
  </div>
{%- endif -%}
