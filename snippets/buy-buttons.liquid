{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="buy-buttons" id="BuyButtons-{{ section_id }}">
  <div class="product-form__error-message-wrapper" role="alert" hidden>
    <span class="product-form__error-icon">{% render 'icon-error' %}</span>
    <span class="product-form__error-message"></span>
  </div>

  <button
    type="submit"
    name="add"
    class="product-form__submit button button--full-width"
    {% if current_variant.available == false %}disabled{% endif %}
    aria-label="{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}"
  >
    <span class="btn__text">
      {%- if current_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </span>
    <div class="loading-overlay__spinner hidden">
      {% render 'loading-spinner' %}
    </div>
  </button>

  {%- if block.settings.show_dynamic_checkout -%}
    <div class="product-form__dynamic-checkout">
      {{ form | payment_button }}
    </div>
  {%- endif -%}
</div>
