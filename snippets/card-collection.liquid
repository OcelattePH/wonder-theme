{%- liquid
  assign media_aspect_ratio = media_aspect_ratio | default: 'adapt'
  assign columns = columns | default: 3

  case columns
    when 1
      assign sizes = '100vw'
    when 2
      assign sizes = '(min-width: 750px) 50vw, 100vw'
    when 3
      assign sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
    else
      assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  endcase

  case media_aspect_ratio
    when 'portrait'
      assign aspect_class = 'card-collection__media--portrait'
    when 'square'
      assign aspect_class = 'card-collection__media--square'
    else
      assign aspect_class = 'card-collection__media--adapt'
  endcase
-%}

<div class="card-collection">
  <a href="{{ collection.url }}" class="card-collection__link">
    <div class="card-collection__media {{ aspect_class }}">
      {%- if collection.image -%}
        <img
          srcset="
            {{ collection.image | image_url: width: 165 }} 165w,
            {{ collection.image | image_url: width: 360 }} 360w,
            {{ collection.image | image_url: width: 533 }} 533w,
            {{ collection.image | image_url: width: 720 }} 720w,
            {{ collection.image | image_url: width: 940 }} 940w,
            {{ collection.image | image_url: width: 1066 }} 1066w
          "
          src="{{ collection.image | image_url: width: 600 }}"
          sizes="{{ sizes }}"
          alt="{{ collection.image.alt | default: collection.title | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
          loading="lazy"
          class="card-collection__image"
        >
      {%- else -%}
        <div class="card-collection__placeholder">
          {{ 'collection-1' | placeholder_svg_tag: 'card-collection__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="card-collection__info">
      <h3 class="card-collection__title">{{ collection.title | escape }}</h3>
      <span class="card-collection__count">
        {{ collection.products_count }}
        {{ collection.products_count | pluralize: 'product', 'products' }}
      </span>
    </div>
  </a>
</div>

<style>
  .card-collection {
    position: relative;
    border-radius: var(--card-corner-radius);
    border: var(--card-border-width) solid var(--card-border-color);
    overflow: hidden;
    background-color: rgb(var(--color-background));
    transition: box-shadow var(--duration-default) ease;
  }

  .card-collection:hover {
    box-shadow: 0 0.4rem 1.2rem rgba(var(--color-shadow), 0.08);
  }

  .card-collection__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-collection__media {
    position: relative;
    overflow: hidden;
  }

  .card-collection__media--adapt {
    aspect-ratio: auto;
  }

  .card-collection__media--portrait {
    aspect-ratio: 2 / 3;
  }

  .card-collection__media--square {
    aspect-ratio: 1 / 1;
  }

  .card-collection__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) ease;
  }

  .card-collection:hover .card-collection__image {
    transform: scale(1.03);
  }

  .card-collection__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: rgba(var(--color-foreground), 0.04);
  }

  .card-collection__placeholder-svg {
    width: 60%;
    height: 60%;
    fill: rgba(var(--color-foreground), 0.15);
  }

  .card-collection__info {
    padding: 1.6rem;
    text-align: center;
  }

  .card-collection__title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-size-base) * var(--font-scale));
    line-height: 1.3;
    margin-block-end: 0.4rem;
  }

  .card-collection__count {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-collection__image,
    .card-collection {
      transition: none;
    }

    .card-collection:hover .card-collection__image {
      transform: none;
    }
  }
</style>
