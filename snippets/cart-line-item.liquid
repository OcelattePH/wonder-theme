{%- comment -%}
  Renders a single cart line item.

  Params:
    - item: cart line item object
    - index: line item index (1-based)
    - compact: boolean, true for cart drawer mode
{%- endcomment -%}

<div class="cart-item{% if compact %} cart-item--compact{% endif %}" id="CartItem-{{ index }}">
  <div class="cart-item__media">
    <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1">
      {%- if item.image -%}
        <img
          src="{{ item.image | image_url: width: 300 }}"
          alt="{{ item.image.alt | escape }}"
          class="cart-item__image"
          width="150"
          height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
          loading="lazy"
        >
      {%- endif -%}
    </a>
  </div>

  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__name h4">
      {{ item.product.title }}
    </a>

    {%- if item.product.has_only_default_variant == false -%}
      <div class="cart-item__variant">
        {%- for option in item.options_with_values -%}
          <span class="cart-item__option">
            {{ option.name }}: {{ option.value }}{% unless forloop.last %},{% endunless %}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if settings.show_vendor_in_cart -%}
      <div class="cart-item__vendor caption">{{ item.product.vendor }}</div>
    {%- endif -%}

    {%- if item.selling_plan_allocation -%}
      <div class="cart-item__selling-plan caption">
        {{ item.selling_plan_allocation.selling_plan.name }}
      </div>
    {%- endif -%}

    {%- if item.properties.size > 0 -%}
      <ul class="cart-item__properties list-unstyled" role="list">
        {%- for property in item.properties -%}
          {%- assign property_first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and property_first_char != '_' -%}
            <li class="cart-item__property caption">
              <span class="cart-item__property-name">{{ property.first }}:</span>
              {%- if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
              {%- else -%}
                <span class="cart-item__property-value">{{ property.last }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-item__discounts list-unstyled" role="list" aria-label="{{ 'cart.item_discounts' | t }}">
        {%- for discount in item.line_level_discount_allocations -%}
          <li class="cart-item__discount caption">
            <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M7 0h5v5L7.146 9.854a.5.5 0 01-.708 0L2.146 5.561a.5.5 0 010-.707L7 0zm4 1a1 1 0 100 2 1 1 0 000-2z" fill="currentColor"/>
            </svg>
            {{ discount.discount_application.title }} (-{{ discount.amount | money }})
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if compact -%}
      <div class="cart-item__quantity-price">
        <span class="cart-item__quantity-label caption">{{ 'cart.quantity' | t }}: {{ item.quantity }}</span>
        <div class="cart-item__prices">
          {%- if item.original_price != item.final_price -%}
            <dl class="cart-item__discounted-prices">
              <dt class="visually-hidden">{{ 'cart.regular_price' | t }}</dt>
              <dd class="cart-item__old-price caption">
                <s>{{ item.original_line_price | money }}</s>
              </dd>
              <dt class="visually-hidden">{{ 'cart.sale_price' | t }}</dt>
              <dd class="cart-item__final-price caption">
                {{ item.final_line_price | money }}
              </dd>
            </dl>
          {%- else -%}
            <span class="cart-item__price caption">
              {{ item.original_line_price | money }}
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- unless compact -%}
    <div class="cart-item__quantity">
      <label class="visually-hidden" for="Quantity-{{ index }}">
        {{ 'cart.quantity' | t }}
      </label>
      <quantity-input class="quantity" data-url="{{ routes.cart_change_url }}" data-index="{{ index }}">
        <button
          class="quantity__button no-js-hidden"
          name="minus"
          type="button"
          aria-label="{{ 'cart.decrease_quantity' | t: title: item.product.title }}"
        >
          <span aria-hidden="true">&minus;</span>
        </button>
        <input
          class="quantity__input"
          id="Quantity-{{ index }}"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          aria-label="{{ 'cart.quantity' | t }}"
          data-index="{{ index }}"
        >
        <button
          class="quantity__button no-js-hidden"
          name="plus"
          type="button"
          aria-label="{{ 'cart.increase_quantity' | t: title: item.product.title }}"
        >
          <span aria-hidden="true">&plus;</span>
        </button>
      </quantity-input>
      <cart-remove-button
        id="Remove-{{ index }}"
        data-index="{{ index }}"
      >
        <a
          href="{{ item.url_to_remove }}"
          class="button button--tertiary cart-item__remove"
          aria-label="{{ 'cart.remove' | t: title: item.product.title }}"
        >
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
            <path d="M14 3h-3.53a3.07 3.07 0 00-.6-1.65C9.44.82 8.8.5 8 .5s-1.44.32-1.87.85A3.06 3.06 0 005.53 3H2a.5.5 0 000 1h1.25v8c0 1.1.9 2 2 2h5.5c1.1 0 2-.9 2-2V4H14a.5.5 0 000-1zm-7.7-.9A2.07 2.07 0 016.5 1.5 1.55 1.55 0 018 1.5a1.55 1.55 0 011.5 0c.21.17.39.37.5.6h-3.7zM11.75 12c0 .55-.45 1-1 1h-5.5c-.55 0-1-.45-1-1V4h7.5v8z" fill="currentColor"/>
            <path d="M6.5 5.5a.5.5 0 00-.5.5v5a.5.5 0 001 0V6a.5.5 0 00-.5-.5zM9.5 5.5a.5.5 0 00-.5.5v5a.5.5 0 001 0V6a.5.5 0 00-.5-.5z" fill="currentColor"/>
          </svg>
          {{ 'cart.remove' | t }}
        </a>
      </cart-remove-button>
    </div>

    <div class="cart-item__totals">
      <div class="cart-item__prices">
        {%- if item.original_price != item.final_price -%}
          <dl class="cart-item__discounted-prices">
            <dt class="visually-hidden">{{ 'cart.regular_price' | t }}</dt>
            <dd class="cart-item__old-price">
              <s>{{ item.original_line_price | money }}</s>
            </dd>
            <dt class="visually-hidden">{{ 'cart.sale_price' | t }}</dt>
            <dd class="cart-item__final-price">
              {{ item.final_line_price | money }}
            </dd>
          </dl>
        {%- else -%}
          <span class="cart-item__price">
            {{ item.original_line_price | money }}
          </span>
        {%- endif -%}

        {%- if item.unit_price_measurement -%}
          <div class="cart-item__unit-price caption">
            <span class="visually-hidden">{{ 'cart.unit_price' | t }}</span>
            {{ item.unit_price | money }}
            <span aria-hidden="true">/</span>
            <span class="visually-hidden">{{ 'cart.unit_price_separator' | t }}&nbsp;</span>
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{ item.unit_price_measurement.reference_value }}
            {%- endif -%}
            {{ item.unit_price_measurement.reference_unit }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}
</div>
