{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

<cart-notification class="cart-notification" role="alert" aria-live="polite" aria-atomic="true">
  <div id="cart-notification" class="cart-notification__wrapper" hidden>
    <button
      class="cart-notification__close"
      type="button"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20">
        <path d="M5.293 5.293a1 1 0 011.414 0L10 8.586l3.293-3.293a1 1 0 111.414 1.414L11.414 10l3.293 3.293a1 1 0 01-1.414 1.414L10 11.414l-3.293 3.293a1 1 0 01-1.414-1.414L8.586 10 5.293 6.707a1 1 0 010-1.414z" fill="currentColor"/>
      </svg>
    </button>

    <div id="cart-notification-product" class="cart-notification__product">
      <div class="cart-notification__product-image" id="cart-notification-image">
        {%- comment -%} Product image inserted dynamically {%- endcomment -%}
      </div>
      <div class="cart-notification__product-info">
        <h3 class="cart-notification__heading caption-large" id="cart-notification-heading">
          {%- comment -%} Product title inserted dynamically {%- endcomment -%}
        </h3>
        <p class="cart-notification__message caption">{{ 'cart.notification.added' | t }}</p>
      </div>
    </div>

    <div class="cart-notification__links">
      <a href="{{ routes.cart_url }}" class="button button--secondary cart-notification__view-cart">
        {{ 'cart.notification.view_cart' | t }}
        <span class="cart-notification__count badge">
          {{ cart.item_count }}
        </span>
      </a>
      <button
        type="button"
        class="button cart-notification__continue link underlined-link"
      >
        {{ 'cart.continue_shopping' | t }}
      </button>
    </div>
  </div>
</cart-notification>
