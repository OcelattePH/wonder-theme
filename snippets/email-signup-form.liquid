{%- assign form_id = id | default: 'EmailSignup' -%}

<div class="email-signup{% if class %} {{ class }}{% endif %}">
  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">

    {%- if form.posted_successfully? -%}
      <div class="form__message form__message--success" role="status" tabindex="-1" autofocus>
        <p>{{ 'newsletter.success' | t }}</p>
      </div>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="form__message form__message--error" role="alert">
        <p>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      </div>
    {%- endif -%}

    <div class="email-signup__fields">
      <div class="field">
        <input
          type="email"
          name="contact[email]"
          id="{{ form_id }}-email"
          value="{{ form.email }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder=" "
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="{{ form_id }}-error"
          {% endif %}
        >
        <label for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
      </div>

      <button type="submit" class="button" name="commit">
        {{ 'newsletter.button_label' | t }}
      </button>
    </div>
  {%- endform -%}
</div>
