<menu-drawer id="MobileMenuDrawer" class="header-drawer">
  <div class="header-drawer__overlay" data-drawer-overlay></div>

  <div class="header-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="header-drawer__header">
      <button
        class="header-drawer__close"
        type="button"
        aria-label="{{ 'accessibility.close' | t }}"
        data-drawer-close
      >
        {%- render 'icon-close' -%}
      </button>
    </div>

    {%- comment -%} Navigation {%- endcomment -%}
    <nav class="header-drawer__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header-drawer__menu list-unstyled" role="list">
        {%- for link in linklists[menu].links -%}
          <li class="header-drawer__menu-item">
            {%- if link.links != blank -%}
              <details class="header-drawer__submenu-wrapper">
                <summary class="header-drawer__menu-link header-drawer__menu-link--has-children">
                  {{ link.title | escape }}
                  {%- render 'icon-caret' -%}
                </summary>
                <ul class="header-drawer__submenu list-unstyled" role="list">
                  {%- for child_link in link.links -%}
                    <li class="header-drawer__submenu-item">
                      {%- if child_link.links != blank -%}
                        <details class="header-drawer__submenu-wrapper">
                          <summary class="header-drawer__submenu-link header-drawer__menu-link--has-children">
                            {{ child_link.title | escape }}
                            {%- render 'icon-caret' -%}
                          </summary>
                          <ul class="header-drawer__submenu header-drawer__submenu--nested list-unstyled" role="list">
                            {%- for grandchild_link in child_link.links -%}
                              <li class="header-drawer__submenu-item">
                                <a
                                  href="{{ grandchild_link.url }}"
                                  class="header-drawer__submenu-link"
                                  {% if grandchild_link.current %} aria-current="page"{% endif %}
                                >
                                  {{ grandchild_link.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- else -%}
                        <a
                          href="{{ child_link.url }}"
                          class="header-drawer__submenu-link"
                          {% if child_link.current %} aria-current="page"{% endif %}
                        >
                          {{ child_link.title | escape }}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="header-drawer__menu-link"
                {% if link.current %} aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Account link {%- endcomment -%}
    {%- if shop.customer_accounts_enabled -%}
      <div class="header-drawer__account">
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-drawer__account-link">
          {%- render 'icon-account' -%}
          <span>{{ 'customer.account.title' | t }}</span>
        </a>
      </div>
    {%- endif -%}

    {%- comment -%} Localization selectors {%- endcomment -%}
    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      <div class="header-drawer__localization">
        {%- form 'localization', id: 'DrawerLocalizationForm', class: 'header-drawer__localization-form' -%}
          {%- if localization.available_countries.size > 1 -%}
            <div class="header-drawer__selector">
              <label class="caption" for="DrawerCountrySelector">{{ 'localization.country_label' | t }}</label>
              <div class="select">
                <select id="DrawerCountrySelector" name="country_code">
                  {%- for country in localization.available_countries -%}
                    <option
                      value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %} selected{% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            </div>
          {%- endif -%}

          {%- if localization.available_languages.size > 1 -%}
            <div class="header-drawer__selector">
              <label class="caption" for="DrawerLanguageSelector">{{ 'localization.language_label' | t }}</label>
              <div class="select">
                <select id="DrawerLanguageSelector" name="locale_code">
                  {%- for language in localization.available_languages -%}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.iso_code %} selected{% endif %}
                      lang="{{ language.iso_code }}"
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            </div>
          {%- endif -%}

          <button type="submit" class="button button--small">
            {{ 'localization.update_country' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</menu-drawer>

<script>
  if (!customElements.get('menu-drawer')) {
    class MenuDrawer extends HTMLElement {
      constructor() {
        super();
        this.panel = this.querySelector('.header-drawer__panel');
        this.overlay = this.querySelector('[data-drawer-overlay]');
        this.closeBtn = this.querySelector('[data-drawer-close]');

        /* Open trigger lives in the header section */
        this.openBtn = document.querySelector('[aria-controls="MobileMenuDrawer"]');
      }

      connectedCallback() {
        this.openBtn?.addEventListener('click', this.open.bind(this));
        this.closeBtn?.addEventListener('click', this.close.bind(this));
        this.overlay?.addEventListener('click', this.close.bind(this));
      }

      open() {
        this.panel.classList.add('is-open');
        this.overlay.classList.add('is-visible');
        this.openBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        this.closeBtn?.focus();
      }

      close() {
        this.panel.classList.remove('is-open');
        this.overlay.classList.remove('is-visible');
        this.openBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        this.openBtn?.focus();
      }
    }

    customElements.define('menu-drawer', MenuDrawer);
  }
</script>

<style>
  .header-drawer {
    /* Container is invisible by default; children handle their own visibility */
  }

  .header-drawer__overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-default) ease,
                visibility var(--duration-default) ease;
  }

  .header-drawer__overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .header-drawer__panel {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 1000;
    width: min(36rem, 85vw);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform var(--duration-long) var(--ease-out-slow, cubic-bezier(0, 0, 0.3, 1));
    display: flex;
    flex-direction: column;
  }

  [dir='rtl'] .header-drawer__panel {
    inset-inline-start: auto;
    inset-inline-end: 0;
    transform: translateX(100%);
  }

  .header-drawer__panel.is-open {
    transform: translateX(0);
  }

  .header-drawer__header {
    display: flex;
    justify-content: flex-end;
    padding: 1.6rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .header-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: none;
    border: none;
    cursor: pointer;
    color: rgb(var(--color-foreground));
  }

  .header-drawer__close svg {
    width: 2rem;
    height: 2rem;
  }

  .header-drawer__nav {
    flex: 1;
    padding: 1.6rem;
  }

  .header-drawer__menu {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .header-drawer__menu-item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.06);
  }

  .header-drawer__menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 0;
    font-size: 1.6rem;
    font-weight: 500;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: start;
  }

  .header-drawer__menu-link svg {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform var(--duration-default) ease;
  }

  details[open] > .header-drawer__menu-link svg,
  details[open] > .header-drawer__menu-link--has-children svg {
    transform: rotate(180deg);
  }

  .header-drawer__submenu {
    padding-inline-start: 1.6rem;
    padding-bottom: 0.8rem;
  }

  .header-drawer__submenu--nested {
    padding-inline-start: 1.6rem;
  }

  .header-drawer__submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0;
    font-size: 1.4rem;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.75);
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: start;
  }

  .header-drawer__submenu-link svg {
    width: 1rem;
    height: 1rem;
  }

  .header-drawer__account {
    padding: 1.6rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .header-drawer__account-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }

  .header-drawer__account-link svg {
    width: 2rem;
    height: 2rem;
  }

  .header-drawer__localization {
    padding: 1.6rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .header-drawer__localization-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .header-drawer__selector {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  @media screen and (min-width: 990px) {
    .header-drawer,
    .header-drawer__overlay,
    .header-drawer__panel {
      display: none !important;
    }
  }
</style>
