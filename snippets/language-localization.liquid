{% doc %}
  Language selector for localization.
  Lists available languages and submits on change.
{% enddoc %}

{%- form 'localization' -%}
  <div class="localization-form__select">
    <label for="LanguageLocalization" class="visually-hidden">
      {{ 'localization.language_label' | t | default: 'Language' }}
    </label>
    <select
      id="LanguageLocalization"
      name="locale_code"
      onchange="this.form.submit()"
    >
      {%- for language in localization.available_languages -%}
        <option
          value="{{ language.iso_code }}"
          {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
        >
          {{ language.endonym_name | capitalize }}
        </option>
      {%- endfor -%}
    </select>
  </div>
{%- endform -%}
