{%- comment -%}
  SEO meta tags, Open Graph, Twitter Card, hreflang, and JSON-LD structured data.
{%- endcomment -%}

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

{%- comment -%} Open Graph tags {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">

{%- if request.page_type == 'product' -%}
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.title | escape }}">
  <meta property="og:description" content="{{ product.description | strip_html | truncatewords: 40 | escape }}">
  {%- if product.featured_image -%}
    <meta property="og:image" content="http:{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ product.featured_image.width }}">
    <meta property="og:image:height" content="{{ product.featured_image.height }}">
    <meta property="og:image:alt" content="{{ product.featured_image.alt | escape }}">
  {%- endif -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.available -%}
    <meta property="og:availability" content="instock">
  {%- else -%}
    <meta property="og:availability" content="outofstock">
  {%- endif -%}

{%- elsif request.page_type == 'article' -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ article.title | escape }}">
  <meta property="og:description" content="{{ article.excerpt_or_content | strip_html | truncatewords: 40 | escape }}">
  {%- if article.image -%}
    <meta property="og:image" content="http:{{ article.image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ article.image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ article.image.width }}">
    <meta property="og:image:height" content="{{ article.image.height }}">
    <meta property="og:image:alt" content="{{ article.image.alt | escape }}">
  {%- endif -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:author" content="{{ article.author }}">
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}

{%- elsif request.page_type == 'collection' -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ collection.title | escape }}">
  <meta property="og:description" content="{{ collection.description | strip_html | truncatewords: 40 | escape }}">
  {%- if collection.image -%}
    <meta property="og:image" content="http:{{ collection.image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ collection.image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ collection.image.width }}">
    <meta property="og:image:height" content="{{ collection.image.height }}">
    <meta property="og:image:alt" content="{{ collection.image.alt | escape }}">
  {%- endif -%}

{%- elsif request.page_type == 'blog' -%}
  <meta property="og:type" content="blog">
  <meta property="og:title" content="{{ blog.title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}

{%- elsif request.page_type == 'password' -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ shop.name }}">
  {%- if shop.description != blank -%}
    <meta property="og:description" content="{{ shop.description | escape }}">
  {%- endif -%}

{%- else -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if settings.share_image -%}
    <meta property="og:image" content="http:{{ settings.share_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ settings.share_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ settings.share_image.width }}">
    <meta property="og:image:height" content="{{ settings.share_image.height }}">
    <meta property="og:image:alt" content="{{ settings.share_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} Twitter Card {%- endcomment -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if page_description -%}
  <meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif -%}

{%- comment -%} Hreflang alternates for published locales {%- endcomment -%}
{%- if request.page_type != 'captcha' -%}
  {%- for locale in shop.published_locales -%}
    <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ canonical_url | replace: request.locale.root_url, locale.root_url }}">
  {%- endfor -%}
  <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
{%- endif -%}

{%- comment -%} JSON-LD: Organization + WebSite with SearchAction {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: '/' | json }}
    {%- if settings.share_image -%}
      ,"logo": {{ settings.share_image | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: '/' | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
      "query-input": "required name=search_term_string"
    }
  }
</script>

{%- comment -%} JSON-LD: Product {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ product.description | strip_html | truncatewords: 120 | json }},
      {%- if product.featured_image -%}
        "image": [
          {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
        ],
      {%- endif -%}
      {%- if product.vendor != blank -%}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.barcode != blank -%}
        "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
      {%- endif -%}
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ request.origin | append: variant.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ variant.price | money_without_currency | json }},
            {%- if variant.available -%}
              "availability": "https://schema.org/InStock"
            {%- else -%}
              "availability": "https://schema.org/OutOfStock"
            {%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- comment -%} JSON-LD: Article {%- endcomment -%}
{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ article.excerpt_or_content | strip_html | truncatewords: 120 | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- if article.updated_at -%}
        "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- endif -%}
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      {%- if article.image -%}
        "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif -%}
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
        {%- if settings.share_image -%}
          ,"logo": {
            "@type": "ImageObject",
            "url": {{ settings.share_image | image_url: width: 600 | prepend: 'https:' | json }}
          }
        {%- endif -%}
      }
    }
  </script>
{%- endif -%}

{%- comment -%} JSON-LD: BreadcrumbList for product pages {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumbs.home' | t | json }},
          "item": {{ request.origin | append: '/' | json }}
        }
        {%- if product.collections.size > 0 -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.collections.first.title | json }},
            "item": {{ request.origin | append: product.collections.first.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{%- comment -%} JSON-LD: BreadcrumbList for collection pages {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumbs.home' | t | json }},
          "item": {{ request.origin | append: '/' | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }}
        }
      ]
    }
  </script>
{%- endif -%}
