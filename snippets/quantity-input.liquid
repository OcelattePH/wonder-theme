<quantity-input class="quantity">
  <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t }}">
    {% render 'icon-minus' %}
  </button>
  <input
    class="quantity__input"
    type="number"
    name="quantity"
    id="{{ id }}"
    min="1"
    value="1"
  >
  <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t }}">
    {% render 'icon-plus' %}
  </button>
</quantity-input>
