{%- if product.metafields.reviews.rating.value != blank -%}
  {%- assign rating_value = product.metafields.reviews.rating.value.rating | round: 1 -%}
  {%- assign rating_max = product.metafields.reviews.rating.value.scale_max -%}
  {%- assign rating_count = product.metafields.reviews.rating_count.value -%}

  <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max }}">
    <div class="rating__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        {%- if rating_value >= i -%}
          {% render 'icon-star' %}
        {%- elsif rating_value > i | minus: 1 -%}
          {% render 'icon-star' %}
        {%- else -%}
          {% render 'icon-star-empty' %}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if rating_count != blank and rating_count > 0 -%}
      <span class="rating__count caption">
        ({{ rating_count }})
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
